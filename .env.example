# =============================================================================
# Agro-Gestão — variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores. Nunca versione o .env.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
# Senha do banco usado pelo serviço postgres e pelo backend (JDBC).
POSTGRES_PASSWORD=altere-esta-senha-do-postgres

# --- JWT (autenticação e-mail/senha) ----------------------------------------
# Segredo para assinar tokens. ALTERE este valor antes de subir o ambiente.
# Sugestão: openssl rand -hex 32
JWT_SECRET=8f3a1c9e2b74d0a65c18e4f7b2d93a0c5e17f6a8b4c2d1e0f9a3b7c5d8e2f146

# --- Gemini (Google AI Studio) ----------------------------------------------
# Chave da API generativa para análise de PDF. NÃO é credencial OAuth.
# Obtenha em: https://aistudio.google.com/apikey
# Sem esta chave o restante da aplicação funciona; a análise de PDF falha
# com mensagem clara.
GEMINI_API_KEY=
# Modelo padrão. Só altere se souber que tem acesso a outro.
GEMINI_MODEL=gemini-2.5-flash

# --- Google OAuth 2.0 (login social, opcional) ------------------------------
# Credenciais do cliente Web no Google Cloud Console.
# NÃO confundir com GEMINI_API_KEY. Sem estes valores, o login por
# e-mail e senha continua disponível.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MinIO (armazenamento de arquivos, bucket privado) ----------------------
MINIO_ROOT_USER=agrogestao
MINIO_ROOT_PASSWORD=altere-esta-senha-do-minio
# Chaves de acesso usadas pelo backend (em dev, iguais ao usuário root).
MINIO_ACCESS_KEY=agrogestao
MINIO_SECRET_KEY=altere-esta-senha-do-minio
MINIO_BUCKET=agro-gestao

# --- Aplicação --------------------------------------------------------------
# Origem do frontend (CORS e redirecionamentos OAuth).
APP_FRONTEND_URL=http://localhost
